# Interactive Brokers
# IP-whitelist both keys to your TrueNAS internal IP (192.168.2.15) only.
# Ensure the IBKR account has WITHDRAWALS DISABLED for this API credential.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497          # 7497 = paper, 7496 = live — DO NOT change to live without 90-day paper validation
IBKR_CLIENT_ID=1
IBKR_READONLY_KEY=      # Market data key (read-only permissions)
IBKR_TRADING_KEY=       # Trading key (order submit permissions, no withdrawal)

# Alpaca (data only in prototype phase)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Finnhub
FINNHUB_API_KEY=

# Telegram alerting
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Healthchecks.io heartbeat
HEALTHCHECKS_URL=

# Model / data paths (Docker internal — override only if volume mapping changes)
DATA_PATH=/data
MODEL_PATH=/data/models

# Risk parameters
MAX_POSITIONS=10
MAX_POSITION_PCT=0.08
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
HOLDING_DAYS=5

# Regime gate thresholds
VIX_BEAR_THRESHOLD=25
